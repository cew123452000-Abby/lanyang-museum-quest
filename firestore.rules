rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isStudent() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function validSession() {
      return request.resource.data.nickname is string
             && request.resource.data.nickname.size() <= 40
             && request.resource.data.completedCount is int
             && request.resource.data.completedCount >= 0
             && request.resource.data.completedCount <= 6
             && request.resource.data.elapsedSeconds >= 0;
    }

    match /sessions/{sessionId} {
      allow create: if isStudent()
                    && request.resource.data.ownerUid == request.auth.uid
                    && validSession();
      allow update: if isStudent()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && validSession();
      allow read, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
